HOST=127.0.0.1
PORT=4310
APP_ORIGIN=http://127.0.0.1:4310
NODE_ENV=development
DATA_DIR=./data
SECRET_DIR=./.secrets
# Required in production: 32 random bytes as base64, injected from a secret manager.
# MASTER_KEY=
# Require this explicit opt-in before connecting to local Ollama.
ALLOW_LOCAL_MODELS=false
# Personal loopback-only Codex CLI connection; uses the CLI's ChatGPT sign-in.
ALLOW_CODEX=false
ALLOW_CLAUDE_CLI=false
# Set CODEX_BIN to an absolute codex executable path if it is not on PATH.
# Production uploads require an absolute executable path, e.g. clamdscan.
# SCANNER_COMMAND=

# Optional Google OAuth Desktop app, for personal loopback Folio.
# Enable the Google Drive API and Google Docs API in the OAuth client's project.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=

# Optional approved Reddit app for OAuth search and nested comments.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
